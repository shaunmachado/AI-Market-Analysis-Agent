# Copy to .env and fill in. .env is git-ignored; this example file is committed.
# Deliberately NOT named ANTHROPIC_API_KEY, so Claude Code itself never picks it up.
# Leave blank to use your Claude Code login (subscription) instead.
MARKET_AGENT_ANTHROPIC_KEY=

# Optional: enables search by meaning (key from dash.voyageai.com). Blank = keyword search only.
VOYAGE_API_KEY=

# Company filings (filings.py): your name and email, sent to the SEC with each request.
# The SEC asks automated tools to say who they are. Required for the Filings tab and its checks.
SEC_CONTACT=
